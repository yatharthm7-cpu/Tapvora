# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Used to construct the permanent URL encoded into QR and NFC.
NEXT_PUBLIC_SITE_URL=https://tapvora.vercel.app

# Server-only Google Places API (New) key for the review-link generator.
GOOGLE_MAPS_API_KEY=your_google_maps_platform_key
